# Copy to .env and fill in the values: cp .env.example .env

# Port Switchyard listens on (the same port is published by docker-compose.yml).
PORT=8080

# Directory of the SQLite database. docker-compose.yml always uses /data (a named volume).
DATA_DIR=./data

# Initial admin password for the web GUI (at least 8 characters).
# Only used on the first start; change the password later in Settings.
ADMIN_PASSWORD=

# Encrypts upstream API keys and proxy passwords at rest (at least 16 characters).
# Generate one with: openssl rand -hex 32
# Keep it safe and never change it: data encrypted with it cannot be read with another key.
ENCRYPTION_KEY=
